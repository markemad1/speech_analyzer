   "source": [
    "# \u2728 Notebook 5: Integration & Evaluation\n",
    "\n",
    "Combines all models into a unified **Presentation Analyzer** pipeline:\n",
    "1. **ASR** (Whisper LoRA) \u2192 transcript\n",
    "2. **Prosody/Fluency** (XGBoost ensemble) \u2192 speech scores\n",
    "3. **Content** (LLM) \u2192 structure scores\n",
    "4. **Ensemble** \u2192 final presentation score + detailed report\n",
    "\n",
    "**Target:** > 80% accuracy on overall presentation assessment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "request_gpu": true
    }
   },
   "outputs": [],
   "source": [
    "# Install dependencies\n",
    "!pip install -q transformers==4.39.0 torch==2.2.0 torchaudio==2.3.0 librosa==0.10.2 peft==0.10.0 opensmile==3.0.2 xgboost==2.0.3 lightgbm==4.3.0 scikit-learn==1.3.2 pandas==2.1.4 joblib==1.3.2\n",
    "\n",
    "import torch\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from dataclasses import dataclass, asdict\n",
    "from typing import Dict, List, Optional\n",
    "import librosa\n",
    "import opensmile\n",
    "import joblib\n",
    "\n",
    "from transformers import WhisperProcessor, WhisperForConditionalGeneration\n",
    "from peft import PeftModel\n",
    "\n",
    "print(f\"GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load all models\n",
    "MODEL_DIR = Path(\"/content/speech_analyzer/models\")\n",
    "\n",
    "# 1. Whisper ASR\n",
    "print(\"Loading Whisper...\")\n",
    "whisper_processor = WhisperProcessor.from_pretrained(MODEL_DIR / \"whisper_large_v3_lora\")\n",
    "whisper_model = WhisperForConditionalGeneration.from_pretrained(\n",
    "    \"openai/whisper-large-v3\",\n",
    "    torch_dtype=torch.float16,\n",
    "    device_map=\"auto\"\n",
    ")\n",
    "whisper_model = PeftModel.from_pretrained(whisper_model, MODEL_DIR / \"whisper_large_v3_lora\" / \"lora_adapter\")\n",
    "whisper_model.eval()\n",
    "\n",
    "# 2. Prosody/Fluency models\n",
    "print(\"Loading prosody models...\")\n",
    "prosody_dir = MODEL_DIR / \"prosody_fluency\"\n",
    "scaler = joblib.load(prosody_dir / \"scaler.pkl\")\n",
    "feature_names = joblib.load(prosody_dir / \"feature_names.pkl\")\n",
    "\n",
    "prosody_models = {}\n",
    "for target in ['fluency', 'prosody', 'pronunciation', 'overall']:\n",
    "    prosody_models[target] = {\n",
    "        'xgb': joblib.load(prosody_dir / f\"xgb_{target}.pkl\"),\n",
    "        'lgb': joblib.load(prosody_dir / f\"lgb_{target}.pkl\"),\n",
    "        'mlp': joblib.load(prosody_dir / f\"mlp_{target}.pkl\")\n",
    "    }\n",
    "\n",
    "# 3. OpenSMILE for feature extraction\n",
    "smile = opensmile.Smile(\n",
    "    feature_set=opensmile.FeatureSet.eGeMAPSv02,\n",
    "    feature_level=opensmile.FeatureLevel.Functionals,\n",
    ")\n",
    "\n",
    "print(\"\u2705 All models loaded\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\n",
    "class ASRResult:\n",
    "    transcript: str\n",
    "    language: str\n",
    "    duration: float\n",
    "    wer_estimate: Optional[float] = None\n",
    "\n",
    "@dataclass\n",
    "class ProsodyResult:\n",
    "    fluency: float\n",
    "    prosody: float\n",
    "    pronunciation: float\n",
    "    overall_speech: float\n",
    "    features: Dict\n",
    "\n",
    "@dataclass\n",
    "class ContentResult:\n",
    "    organization: float\n",
    "    clarity: float\n",
    "    completeness: float\n",
    "    engagement: float\n",
    "    scientific_rigor: float\n",
    "    overall_content: float\n",
    "    feedback: str\n",
    "    missing_elements: List[str]\n",
    "    strengths: List[str]\n",
    "    improvements: List[str]\n",
    "\n",
    "@dataclass\n",
    "class PresentationReport:\n",
    "    asr: ASRResult\n",
    "    prosody: ProsodyResult\n",
    "    content: ContentResult\n",
    "    overall_score: float\n",
    "    grade: str\n",
    "    summary: str\n",
    "    detailed_feedback: Dict\n",
    "\n",
    "    def to_dict(self):\n",
    "        return asdict(self)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class PresentationAnalyzer:\n",
    "    def __init__(self):\n",
    "        self.whisper_processor = whisper_processor\n",
    "        self.whisper_model = whisper_model\n",
    "        self.prosody_models = prosody_models\n",
    "        self.scaler = scaler\n",
    "        self.feature_names = feature_names\n",
    "        self.smile = smile\n",
    "        \n",
    "    def transcribe(self, audio_path: str) -> ASRResult:\n",
    "        \"\"\"Transcribe audio with Whisper.\"\"\"\n",
    "        audio, sr = librosa.load(audio_path, sr=16000)\n",
    "        duration = len(audio) / sr\n",
    "        \n",
    "        inputs = self.whisper_processor(\n",
    "            audio, \n",
    "            sampling_rate=16000,\n",
    "            return_tensors=\"pt\"\n",
    "        ).input_features.to(self.whisper_model.device)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            predicted_ids = self.whisper_model.generate(inputs, language=\"en\", task=\"transcribe\")\n",
    "        \n",
    "        transcript = self.whisper_processor.batch_decode(predicted_ids, skip_special_tokens=True)[0]\n",
    "        \n",
    "        return ASRResult(\n",
    "            transcript=transcript,\n",
    "            language=\"en\",\n",
    "            duration=duration\n",
    "        )\n",
    "    \n",
    "    def analyze_prosody(self, audio_path: str) -> ProsodyResult:\n",
    "        \"\"\"Extract prosody features and predict scores.\"\"\"\n",
    "        audio, sr = librosa.load(audio_path, sr=16000)\n",
    "        \n",
    "        # Extract eGeMAPS features\n",
    "        feats_df = self.smile.process_signal(audio, sr)\n",
    "        features = {}\n",
    "        for idx, name in enumerate(self.smile.feature_names):\n",
    "            features[name] = float(feats_df.iloc[0, idx])\n",
    "        \n",
    "        # Prepare feature vector\n",
    "        X = np.array([[features.get(name, 0) for name in self.feature_names]])\n",
    "        X_scaled = self.scaler.transform(X)\n",
    "        \n",
    "        # Ensemble prediction\n",
    "        results = {}\n",
    "        for target in ['fluency', 'prosody', 'pronunciation', 'overall']:\n",
    "            models = self.prosody_models[target]\n",
    "            preds = [\n",
    "                models['xgb'].predict(X_scaled)[0],\n",
    "                models['lgb'].predict(X_scaled)[0],\n",
    "                models['mlp'].predict(X_scaled)[0]\n",
    "            ]\n",
    "            results[target] = np.mean(preds)\n",
    "        \n",
    "        return ProsodyResult(\n",
    "            fluency=np.clip(results['fluency'], 0, 1),\n",
    "            prosody=np.clip(results['prosody'], 0, 1),\n",
    "            pronunciation=np.clip(results['pronunciation'], 0, 1),\n",
    "            overall_speech=np.clip(results['overall'], 0, 1),\n",
    "            features=features\n",
    "        )\n",
    "    \n",
    "    def analyze_content(self, transcript: str) -> ContentResult:\n",
    "        \"\"\"Analyze content structure (placeholder - uses LLM API).\"\"\"\n",
    "        # This would call the LLM API from Notebook 4\n",
    "        # For now, return mock results based on transcript analysis\n",
    "        \n",
    "        word_count = len(transcript.split())\n",
    "        has_hypothesis = 'hypothesis' in transcript.lower()\n",
    "        has_method = any(w in transcript.lower() for w in ['method', 'experiment', 'procedure'])\n",
    "        has_results = any(w in transcript.lower() for w in ['result', 'found', 'show', 'data'])\n",
    "        has_conclusion = any(w in transcript.lower() for w in ['conclusion', 'conclude', 'summary'])\n",
    "        \n",
    "        base = 0.5\n",
    "        org = base + 0.1 * sum([has_hypothesis, has_method, has_results, has_conclusion])\n",
    "        clarity = min(1.0, base + 0.05 * (word_count / 100))\n",
    "        complete = base + 0.15 * sum([has_hypothesis, has_method, has_results, has_conclusion])\n",
    "        engage = base + 0.1\n",
    "        rigor = base + 0.15 * sum([has_hypothesis, has_method, has_results, has_conclusion])\n",
    "        \n",
    "        overall = 0.2*org + 0.2*clarity + 0.15*complete + 0.15*engage + 0.3*rigor\n",
    "        \n",
    "        return ContentResult(\n",
    "            organization=np.clip(org, 0, 1),\n",
    "            clarity=np.clip(clarity, 0, 1),\n",
    "            completeness=np.clip(complete, 0, 1),\n",
    "            engagement=np.clip(engage, 0, 1),\n",
    "            scientific_rigor=np.clip(rigor, 0, 1),\n",
    "            overall_content=np.clip(overall, 0, 1),\n",
    "            feedback=\"Automated analysis - connect LLM API for full scoring\",\n",
    "            missing_elements=[],\n",
    "            strengths=[],\n",
    "            improvements=[\"Connect LLM API for detailed content analysis\"]\n",
    "        )\n",
    "    \n",
    "    def analyze(self, audio_path: str) -> PresentationReport:\n",
    "        \"\"\"Full pipeline analysis.\"\"\"\n",
    "        print(f\"Analyzing {audio_path}...\")\n",
    "        \n",
    "        # 1. ASR\n",
    "        asr_result = self.transcribe(audio_path)\n",
    "        print(f\"  Transcript: {asr_result.transcript[:100]}...\")\n",
    "        \n",
    "        # 2. Prosody\n",
    "        prosody_result = self.analyze_prosody(audio_path)\n",
    "        print(f\"  Speech scores: fluency={prosody_result.fluency:.2f}, prosody={prosody_result.prosody:.2f}\")\n",
    "        \n",
    "        # 3. Content\n",
    "        content_result = self.analyze_content(asr_result.transcript)\n",
    "        print(f\"  Content scores: org={content_result.organization:.2f}, rigor={content_result.scientific_rigor:.2f}\")\n",
    "        \n",
    "        # 4. Ensemble overall score\n",
    "        # Weights: 40% speech delivery, 60% content\n",
    "        speech_score = prosody_result.overall_speech\n",
    "        content_score = content_result.overall_content\n",
    "        overall = 0.4 * speech_score + 0.6 * content_score\n",
    "        \n",
    "        # Grade\n",
    "        if overall >= 0.9: grade = \"A+\"\n",
    "        elif overall >= 0.8: grade = \"A\"\n",
    "        elif overall >= 0.7: grade = \"B\"\n",
    "        elif overall >= 0.6: grade = \"C\"\n",
    "        elif overall >= 0.5: grade = \"D\"\n",
    "        else: grade = \"F\"\n",
    "        \n",
    "        # Summary\n",
    "        summary = f\"Overall score: {overall:.1%} ({grade}). \"\n",
    "        if speech_score > content_score:\n",
    "            summary += \"Strong delivery, content could be improved.\"\n",
    "        else:\n",
    "            summary += \"Good content, work on delivery skills.\"\n",
    "        \n",
    "        detailed_feedback = {\n",
    "            \"speech_delivery\": {\n",
    "                \"fluency\": prosody_result.fluency,\n",
    "                \"prosody\": prosody_result.prosody,\n",
    "                \"pronunciation\": prosody_result.pronunciation\n",
    "            },\n",
    "            \"content_structure\": {\n",
    "                \"organization\": content_result.organization,\n",
    "                \"clarity\": content_result.clarity,\n",
    "                \"completeness\": content_result.completeness,\n",
    "                \"engagement\": content_result.engagement,\n",
    "                \"scientific_rigor\": content_result.scientific_rigor\n",
    "            },\n",
    "            \"weights\": {\n",
    "                \"speech_delivery\": 0.4,\n",
    "                \"content_structure\": 0.6\n",
    "            }\n",
    "        }\n",
    "        \n",
    "        return PresentationReport(\n",
    "            asr=asr_result,\n",
    "            prosody=prosody_result,\n",
    "            content=content_result,\n",
    "            overall_score=overall,\n",
    "            grade=grade,\n",
    "            summary=summary,\n",
    "            detailed_feedback=detailed_feedback\n",
    "        )"
   ]
  },
  {
