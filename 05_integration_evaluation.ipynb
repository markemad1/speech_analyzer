   "source": [
    "# Test with a sample audio file\n",
    "# First, create a test audio using TTS or use an existing file\n",
    "\n",
    "# For demo, we'll use a sample from the dataset\n",
    "from datasets import load_from_disk\n",
    "test_dataset = load_from_disk(\"/content/speech_analyzer/data/processed/combined_whisper\")[\"test\"]\n",
    "\n",
    "# Save a test audio file\n",
    "import soundfile as sf\n",
    "sample = test_dataset[0]\n",
    "test_audio_path = \"/content/test_sample.wav\"\n",
    "sf.write(test_audio_path, sample[\"audio\"][\"array\"], sample[\"audio\"][\"sampling_rate\"])\n",
    "\n",
    "print(f\"Test audio saved: {test_audio_path}\")\n",
    "print(f\"Ground truth: {sample['text']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run analysis\n",
    "analyzer = PresentationAnalyzer()\n",
    "report = analyzer.analyze(test_audio_path)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"PRESENTATION ANALYSIS REPORT\")\n",
    "print(\"=\"*60)\n",
    print(f\"Overall Score: {report.overall_score:.1%} ({report.grade})\")\n",
    print(f\"Summary: {report.summary}\")\n",
    print(f\"\\nTranscript: {report.asr.transcript}\")\n",
    print(f\"\\nSpeech Delivery:\")\n",
    print(f\"  Fluency: {report.prosody.fluency:.2f}\")\n",
    print(f\"  Prosody: {report.prosody.prosody:.2f}\")\n",
    print(f\"  Pronunciation: {report.prosody.pronunciation:.2f}\")\n",
    print(f\"  Overall Speech: {report.prosody.overall_speech:.2f}\")\n",
    print(f\"\\nContent Structure:\")\n",
    print(f\"  Organization: {report.content.organization:.2f}\")\n",
    print(f\"  Clarity: {report.content.clarity:.2f}\")\n",
    print(f\"  Completeness: {report.content.completeness:.2f}\")\n",
    print(f\"  Engagement: {report.content.engagement:.2f}\")\n",
    print(f\"  Scientific Rigor: {report.content.scientific_rigor:.2f}\")\n",
    print(f\"  Overall Content: {report.content.overall_content:.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate on test set\n",
    "print(\"Running evaluation on test set...\")\n",
    "\n",
    "test_samples = test_dataset.shuffle(seed=42).select(range(50))\n",
    "results = []\n",
    "\n",
    "for i, sample in enumerate(tqdm(test_samples, desc=\"Evaluating\")):\n",
    "    # Save temp audio\n",
    "    temp_path = f\"/content/temp_eval_{i}.wav\"\n",
    "    sf.write(temp_path, sample[\"audio\"][\"array\"], sample[\"audio\"][\"sampling_rate\"])\n",
    "    \n",
    "    try:\n",
    "        report = analyzer.analyze(temp_path)\n",
    "        \n",
    "        # Compare ASR with ground truth\n",
    "        import jiwer\n",
    "        wer = jiwer.wer(sample[\"text\"], report.asr.transcript)\n",
    "        \n",
    "        results.append({\n",
    "            \"wer\": wer,\n",
    "            \"overall_score\": report.overall_score,\n",
    "            \"speech_score\": report.prosody.overall_speech,\n",
    "            \"content_score\": report.content.overall_content,\n",
    "            \"grade\": report.grade\n",
    "        })\n",
    "    except Exception as e:\n",
    "        print(f\"Error on sample {i}: {e}\")\n",
    "    \n",
    "    # Cleanup\n",
    "    import os\n",
    "    os.remove(temp_path)\n",
    "\n",
    "print(f\"\\nEvaluated {len(results)} samples\")\n",
    "print(f\"Average WER: {np.mean([r['wer'] for r in results])*100:.1f}%\")\n",
    "print(f\"Average Overall: {np.mean([r['overall_score'] for r in results]):.3f}\")\n",
    "print(f\"Average Speech: {np.mean([r['speech_score'] for r in results]):.3f}\")\n",
    "print(f\"Average Content: {np.mean([r['content_score'] for r in results]):.3f}\")\n",
    "\n",
    "# Grade distribution\n",
    "grades = [r['grade'] for r in results]\n",
    "for g in ['A+', 'A', 'B', 'C', 'D', 'F']:\n",
    "    count = grades.count(g)\n",
    "    if count:\n",
    "        print(f\"  {g}: {count}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save evaluation results\n",
    "EVAL_DIR = Path(\"/content/speech_analyzer/evaluation\")\n",
    "EVAL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "with open(EVAL_DIR / \"evaluation_results.json\", \"w\") as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "\n",
    "# Save analyzer class for reuse\n",
    "import pickle\n",
    "with open(MODEL_DIR / \"presentation_analyzer.pkl\", \"wb\") as f:\n",
    "    pickle.dump(analyzer, f)\n",
    "\n",
    "print(\"Evaluation complete!\")\n",
    "print(f\"Results saved to {EVAL_DIR}\")"
   ]
  },
